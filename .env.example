# Copy to .env (git-ignored). `npm start` / `npm run dev` / `npm run serve` load it via node --env-file-if-exists=.env.
# Telegram is configured on the Integrations page only (bot token, chat, receiver mode); no TELEGRAM_* variable.
# Git hosting credentials (Bitbucket, GitHub, GitLab) are personal and saved in Integrations; no BITBUCKET_*,
# GITHUB_TOKEN or GITLAB_TOKEN variable is read.
# NOTIFY_WEBHOOK=https://chat.googleapis.com/...
# PostgreSQL pool (optional). Defaults suit a remote DB (shared RDS over VPN): 10 connections, 4 kept warm,
# idle clients closed after 5 min, 15s wait for a free/new client.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MIN=4
# DATABASE_IDLE_TIMEOUT_MS=300000
# DATABASE_CONNECTION_TIMEOUT_MS=15000

# Required: generate once with a secure RNG, store privately, and preserve across restarts.
# AUTH_SECRET=
# HTTPS deployments: COOKIE_SECURE=1 (production always uses Secure). Localhost HTTP auto-detected.
# Key rotation (docs/architecture/key-rotation.md). AUTH_SECRET encrypts; AUTH_SECRET_PREVIOUS (comma-separated, no commas
# inside a secret) only decrypts. AUTH_CIPHERTEXT_FORMAT stays "legacy" until EVERY machine sharing the database runs a
# release that reads "v2"; then set it to v2 and run `npm run auth:rotate-keys`.
# AUTH_SECRET_PREVIOUS=
# AUTH_CIPHERTEXT_FORMAT=legacy
# Reverse proxies in front of this server that append to X-Forwarded-For (0-8). Default 0: the header is ignored and the
# socket address is the client IP, which login throttling keys on. Set it to the real hop count or the IP is spoofable.
# TRUSTED_PROXY_HOPS=0

# Local desktop worker only; defaults to hosted (token paste). Keep HOST loopback.
# HASAKI_WORK_BROWSER_MODE=local
# HASAKI_WORK_CHROME_PATH=/path/to/official/google-chrome

# Use personal running Windows Chrome via WSL (Chrome 144+, browser consent required):
# HASAKI_WORK_CHROME_PROFILE=existing
# HASAKI_WORK_EXISTING_CHROME_USER=toan

# Cost budgets (USD, provider-reported). Empty = no default budget; a run's / work item's own budget overrides these.
# Checked after every attempt: WARN_PCT logs a warning on the run timeline, 100% pauses the run (ACTION=pause|warn).
# COST_BUDGET_RUN_USD=5
# COST_BUDGET_WORK_ITEM_USD=20
# COST_BUDGET_WARN_PCT=0.8
# COST_BUDGET_ACTION=pause

# Shared registry repositories this machine never checks out (comma-separated; silences the startup warning)
# IGNORE_REPOSITORIES=

# Semantic knowledge retrieval (Go service + local Ollama bge-m3, see README): npm start supervises platform-go
# RETRIEVAL_SEMANTIC_ENABLED=true
# RETRIEVAL_INTERNAL_TOKEN=   # openssl rand -hex 32
# RETRIEVAL_SEMANTIC_TIMEOUT_MS=1500   # query embedding + search; raise it for a remote database

# Production scan: requests slower than this (ms) form SigNoz latency groups; 0 = off
# PROD_SLOW_THRESHOLD_MS=1000

# platform-go (started by npm start) serves analytics, code intelligence, code search, the knowledge scan and production
# error scans; there is no TypeScript fallback. Its internal token is generated under ~/.claude-task-platform.
# ANALYTICS_TIMEOUT_MS=15000      # one dashboard read in platform-go, including the wait for an analytics connection
# ANALYTICS_MAX_CONCURRENT=2      # platform-go's separate read-only analytics pool (connections)
# PLATFORM_GO_BIN=go/bin/platform-go   # prebuilt binary (npm run build:go); otherwise built when sources change

# Production error scans run in platform-go; Splunk/SigNoz reads stay in this server's internal gateway with the
# requesting user's integrations (ADR 0004).
# PROD_SCAN_WORKERS=1             # platform-go scans at once (the queue admits one active scan anyway)
# PROD_SCAN_POLL_MS=60000         # fallback poll; enqueueing wakes platform-go at once

# Process supervision of provider CLIs and verification commands (ADR 0005): typescript (default) | go
# (go/cmd/platform-supervise per process: delegated cgroup leaf, cgroup.kill cleanup, limits, host-wide admission).
# PROCESS_SUPERVISION_ENGINE=typescript
# PLATFORM_SUPERVISE_BIN=go/bin/platform-supervise   # prebuilt launcher (npm run build:go); otherwise built at startup

# Code intelligence indexing and search (platform-go)
# CODE_INDEX_PARSE_WORKERS=0   # platform-go parse workers per job; 0 = half the cores, at most 4

# Chat (docs/architecture/chat-performance.md)
# CHAT_TITLE_CONCURRENCY=2   # generated titles at once; they start after the first answer and yield to running turns
# Claude CLI used by the Agent SDK. Set it (e.g. node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude, the
# binary the SDK would pick) to skip the SDK's per-query musl detection (a synchronous process.report.getReport()).
# CLAUDE_CODE_EXECUTABLE=
# Claude prompt-cache lifetime. A subscription login writes the cache with a 1-hour TTL (about 2x the price of a
# 5-minute write); in practice only ~2% of attempts pause longer than 5 minutes inside a session, so 5m is cheaper.
# Unset = the 1-hour default (rollback: remove the line and restart). With isolation.mode "enforce" the sandbox forwards
# only CLAUDE_CODE_*, so use CLAUDE_CODE_PROMPT_CACHE_TTL=5m there (same effect on the main conversation).
# FORCE_PROMPT_CACHING_5M=1

# HTTP (docs/architecture/phase4-performance.md)
# HTTP_COMPRESSION=off   # disable brotli/gzip of the UI bundle and large GET results (e.g. a proxy already compresses)

# Company endpoints. The code has no built-in company domains: set these for your installation.
# FILE_BASE_URL=https://media.example.com/files              # prefix that turns task note_files into download URLs
# BITBUCKET_WORKSPACE=your-workspace
# HASAKI_WORK_API_URL=https://work-api.example.com/api       # Hasaki Work API
# HASAKI_WORK_WEB_URL=https://work.example.com               # Hasaki Work site (browser login)
# ARGOCD_BASE_URL=https://argocd.example.com
# VAULT_BASE_URL=https://vault.example.com
# KAFKA_BASE_URL=https://kafka-ui.example.com
# SPLUNK_BASE_URL=https://splunk.example.com
# PRODUCTION_DOMAINS=example.com                              # comma-separated; hosts under them are never called by QC HTTP

# --- Tunables (each is a named field of `config` in src/config.ts; unset = the default shown) ---
# SESSION_MAX_AGE_HOURS=72                 # login session lifetime
# SESSION_CACHE_MS=10000                   # in-process session lookup cache; 0 disables it
# CACHE=                                   # set to "off" to disable the in-process read caches
# TRACE_MIN_LEVEL=                         # lowest workflow trace level kept (debug|info|warn|error)
# TRACE_DEBUG_RETENTION_DAYS=              # days debug trace events are kept
# VERIFICATION_EVIDENCE_RETENTION_DAYS=    # days verification evidence is kept
# MEMORY_AGING_ENABLED=true               # task memory aging job (docs/architecture/memory-aging.md); false/0 turns it off
# MEMORY_AGING_INTERVAL_MINUTES=60         # at most one pass per interval and process
# MEMORY_AGING_BATCH_SIZE=200              # items whose freshness one pass checks at most
# MEMORY_AGING_CONCURRENCY=4               # freshness checks (git) running at the same time
# MEMORY_AGING_BUDGET_SECONDS=60           # a pass stops starting new work after this long
# MEMORY_AGING_UNKNOWN_DAYS=14             # a permanently unprovable run memory is archived after this long
# MEMORY_AGING_UNAPPROVED_DAYS=30          # agent conclusions still unapproved after this long are archived
# MEMORY_AGING_DORMANT_DAYS=60             # not loaded for this long: verified run memory goes dormant (ranked last)...
# MEMORY_AGING_DISUSE_DAYS=120             # ...and is archived after this long
# MEMORY_AGING_APPROVED_DORMANT_DAYS=120   # same pair for human-approved run memory
# MEMORY_AGING_APPROVED_DISUSE_DAYS=240
# MEMORY_AGING_LESSON_DORMANT_DAYS=90      # same pair for outcome lessons and chat procedures
# MEMORY_AGING_LESSON_DISUSE_DAYS=180
# MEMORY_AGING_DISPUTED_DAYS=30            # a lesson that stays disputed this long is archived
# MEMORY_AGING_CAP_PER_REPO=50             # active run memories per owner and repository; least recently used archived first
# MEMORY_AGING_PURGE_DAYS=90               # archived this long: deleted for good (0 = never delete)
# MEMORY_FRESHNESS_CACHE_MAX=2000          # entries of the in-process memory freshness cache (LRU)
# SHARED_RESULTS_PROD_ERRORS=false         # reuse production error analyses across members (docs/shared-results/PLAN.md); off = as before
# SHARED_RESULTS_CODE_ASSESSMENT=false     # reuse code assessments across members; off = as before
# SHARED_RESULTS_TTL_RCA_HOURS=24          # a shared runtime RCA is served this long
# SHARED_RESULTS_TTL_BUG_HUNT_DAYS=30      # a shared bug hunt (pinned to commits) is served this long
# SHARED_RESULTS_TTL_CODE_ASSESSMENT_DAYS=30
# SHARED_RESULTS_RUNNING_TIMEOUT_MINUTES=360  # a shared analysis running longer than this is failed and its key freed
# SHARED_RESULTS_WAIT_TIMEOUT_MS=30000     # how long a caller waits for a running shared analysis before "timeout"
# SHARED_RESULTS_MAX_ATTEMPTS=3            # failures of one key in a row after which only a force re-run starts it again
# SHARED_RESULTS_RETRY_CAP_MINUTES=60      # a failed key may start again after min(this, 2^failures) minutes
# SPLUNK_POLL_MS=                          # Splunk job poll interval (ms)
# OTEL_EXPORTER_OTLP_ENDPOINT=             # forwarded to platform-supervise
# CHAT_DOCUMENT_MAX_BYTES=                 # largest chat document attachment
# CHAT_DOCUMENTS_PER_MESSAGE=              # documents allowed per chat message
# CHAT_NATIVE_TOOLS=                       # chat native tool switch
# CLAUDE_USER_SKILLS_DIR=~/.claude/skills  # where user skills are imported from
# OCR_BIN=                                 # open-code-review binary
# CURSOR_AGENT_TIMEOUT_MS=2700000          # Cursor turn limit; a bad value warns and keeps 45 minutes
# PLATFORM_CONFIG=                         # optional JSON overlay (test/benchmark fixtures); .env and Settings are the normal route
# Provider overrides, used until the Settings page saves its own value:
# CODEX_MODEL= CODEX_REASONING_EFFORT= AGY_MODEL= ANTIGRAVITY_MODEL= AGY_EFFORT= ANTIGRAVITY_EFFORT=
# AGY_MAX_CONCURRENT= ANTIGRAVITY_MAX_CONCURRENT= COPILOT_MODEL= COPILOT_EFFORT= COPILOT_MAX_CONCURRENT= COPILOT_SANDBOX=
# Provider credentials the CLIs may need (never logged): CLAUDE_CODE_OAUTH_TOKEN and CURSOR_API_KEY. Set them only if used.
# Boolean flags (CODEACT_ENABLED, LSP_ENABLED, RADAR_ENABLED, RETRIEVAL_SEMANTIC_ENABLED, COOKIE_SECURE, ...) accept
# 1/true/yes/on and 0/false/no/off in any case. PORT and ANALYTICS_TIMEOUT_MS must be integers or the server will not start.
