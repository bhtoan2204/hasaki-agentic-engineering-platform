# Copy to .env (git-ignored). `npm start` / `npm run dev` / `npm run serve` load it via node --env-file-if-exists=.env.
# Optional one-way Telegram notifications when a step waits for an answer or an approval.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789
# Other optional secrets
# BITBUCKET_USER=you@hasaki.vn
# BITBUCKET_TOKEN=...
# NOTIFY_WEBHOOK=https://chat.googleapis.com/...
