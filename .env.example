# Copy to .env (git-ignored). `npm start` / `npm run dev` / `npm run serve` load it via node --env-file-if-exists=.env.
# Telegram: off retains legacy one-way notifications; polling supports local/WSL without a public endpoint.
TELEGRAM_MODE=off
# For HTTPS webhook mode only (see docs/integrations/interactive-telegram.md):
# TELEGRAM_WEBHOOK_URL=https://platform.example.com/api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=<random 16-256 character secret>
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789
# Other optional secrets
# BITBUCKET_USER=you@hasaki.vn
# BITBUCKET_TOKEN=...
# NOTIFY_WEBHOOK=https://chat.googleapis.com/...
# PostgreSQL pool (optional). Defaults suit a remote DB (shared RDS over VPN): 10 connections, 4 kept warm,
# idle clients closed after 5 min, 15s wait for a free/new client.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MIN=4
# DATABASE_IDLE_TIMEOUT_MS=300000
# DATABASE_CONNECTION_TIMEOUT_MS=15000

# Required: generate once with a secure RNG, store privately, and preserve across restarts.
# AUTH_SECRET=
# HTTPS deployments: COOKIE_SECURE=1 (production always uses Secure). Localhost HTTP auto-detected.

# Local desktop worker only; defaults to hosted (token paste). Keep HOST loopback.
# HASAKI_WORK_BROWSER_MODE=local
# HASAKI_WORK_CHROME_PATH=/path/to/official/google-chrome

# Use personal running Windows Chrome via WSL (Chrome 144+, browser consent required):
# HASAKI_WORK_CHROME_PROFILE=existing
# HASAKI_WORK_EXISTING_CHROME_USER=toan

# Cost budgets (USD, provider-reported). Empty = no default budget; a run's / work item's own budget overrides these.
# Checked after every attempt: WARN_PCT logs a warning on the run timeline, 100% pauses the run (ACTION=pause|warn).
# COST_BUDGET_RUN_USD=5
# COST_BUDGET_WORK_ITEM_USD=20
# COST_BUDGET_WARN_PCT=0.8
# COST_BUDGET_ACTION=pause
