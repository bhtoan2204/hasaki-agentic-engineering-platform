# Copy to .env (git-ignored). `npm start` / `npm run dev` / `npm run serve` load it via node --env-file-if-exists=.env.
# Telegram is configured on the Integrations page only (bot token, chat, receiver mode); no TELEGRAM_* variable.
# Git hosting credentials (Bitbucket, GitHub, GitLab) are personal and saved in Integrations; no BITBUCKET_*,
# GITHUB_TOKEN or GITLAB_TOKEN variable is read.
# NOTIFY_WEBHOOK=https://chat.googleapis.com/...
# PostgreSQL pool (optional). Defaults suit a remote DB (shared RDS over VPN): 10 connections, 4 kept warm,
# idle clients closed after 5 min, 15s wait for a free/new client.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MIN=4
# DATABASE_IDLE_TIMEOUT_MS=300000
# DATABASE_CONNECTION_TIMEOUT_MS=15000

# Required: generate once with a secure RNG, store privately, and preserve across restarts.
# AUTH_SECRET=
# HTTPS deployments: COOKIE_SECURE=1 (production always uses Secure). Localhost HTTP auto-detected.
# Reverse proxies in front of this server that append to X-Forwarded-For (0-8). Default 0: the header is ignored and the
# socket address is the client IP, which login throttling keys on. Set it to the real hop count or the IP is spoofable.
# TRUSTED_PROXY_HOPS=0

# Local desktop worker only; defaults to hosted (token paste). Keep HOST loopback.
# HASAKI_WORK_BROWSER_MODE=local
# HASAKI_WORK_CHROME_PATH=/path/to/official/google-chrome

# Use personal running Windows Chrome via WSL (Chrome 144+, browser consent required):
# HASAKI_WORK_CHROME_PROFILE=existing
# HASAKI_WORK_EXISTING_CHROME_USER=toan

# Cost budgets (USD, provider-reported). Empty = no default budget; a run's / work item's own budget overrides these.
# Checked after every attempt: WARN_PCT logs a warning on the run timeline, 100% pauses the run (ACTION=pause|warn).
# COST_BUDGET_RUN_USD=5
# COST_BUDGET_WORK_ITEM_USD=20
# COST_BUDGET_WARN_PCT=0.8
# COST_BUDGET_ACTION=pause

# Shared registry repositories this machine never checks out (comma-separated; silences the startup warning)
# IGNORE_REPOSITORIES=

# Semantic knowledge retrieval (Go service + local Ollama bge-m3, see README): npm start supervises platform-go
# RETRIEVAL_SEMANTIC_ENABLED=true
# RETRIEVAL_INTERNAL_TOKEN=   # openssl rand -hex 32
# RETRIEVAL_SEMANTIC_TIMEOUT_MS=1500   # query embedding + search; raise it for a remote database

# Production scan: requests slower than this (ms) form SigNoz latency groups; 0 = off
# PROD_SLOW_THRESHOLD_MS=1000

# platform-go (started by npm start) serves analytics, code intelligence, code search, the knowledge scan and production
# error scans; there is no TypeScript fallback. Its internal token is generated under ~/.claude-task-platform.
# ANALYTICS_TIMEOUT_MS=15000      # one dashboard read in platform-go, including the wait for an analytics connection
# ANALYTICS_MAX_CONCURRENT=2      # platform-go's separate read-only analytics pool (connections)
# PLATFORM_GO_BIN=go/bin/platform-go   # prebuilt binary (npm run build:go); otherwise built when sources change

# Production error scans run in platform-go; Splunk/SigNoz reads stay in this server's internal gateway with the
# requesting user's integrations (ADR 0004).
# PROD_SCAN_WORKERS=1             # platform-go scans at once (the queue admits one active scan anyway)
# PROD_SCAN_POLL_MS=60000         # fallback poll; enqueueing wakes platform-go at once

# Process supervision of provider CLIs and verification commands (ADR 0005): typescript (default) | go
# (go/cmd/platform-supervise per process: delegated cgroup leaf, cgroup.kill cleanup, limits, host-wide admission).
# PROCESS_SUPERVISION_ENGINE=typescript
# PLATFORM_SUPERVISE_BIN=go/bin/platform-supervise   # prebuilt launcher (npm run build:go); otherwise built at startup

# Code intelligence indexing and search (platform-go)
# CODE_INDEX_PARSE_WORKERS=0   # platform-go parse workers per job; 0 = half the cores, at most 4

# Chat (docs/architecture/chat-performance.md)
# CHAT_TITLE_CONCURRENCY=2   # generated titles at once; they start after the first answer and yield to running turns
# Claude CLI used by the Agent SDK. Set it (e.g. node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude, the
# binary the SDK would pick) to skip the SDK's per-query musl detection (a synchronous process.report.getReport()).
# CLAUDE_CODE_EXECUTABLE=
# Claude prompt-cache lifetime. A subscription login writes the cache with a 1-hour TTL (about 2x the price of a
# 5-minute write); in practice only ~2% of attempts pause longer than 5 minutes inside a session, so 5m is cheaper.
# Unset = the 1-hour default (rollback: remove the line and restart). With isolation.mode "enforce" the sandbox forwards
# only CLAUDE_CODE_*, so use CLAUDE_CODE_PROMPT_CACHE_TTL=5m there (same effect on the main conversation).
# FORCE_PROMPT_CACHING_5M=1

# HTTP (docs/architecture/phase4-performance.md)
# HTTP_COMPRESSION=off   # disable brotli/gzip of the UI bundle and large GET results (e.g. a proxy already compresses)
