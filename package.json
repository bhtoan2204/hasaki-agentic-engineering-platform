{
  "name": "claude-task-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workflow-driven AI engineering platform: work items, versioned workflows, durable step execution, Claude Code agents, Bitbucket PRs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "npm run build && node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --watch --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "build": "vite build --config web/vite.config.ts",
    "serve": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "knowledge:import": "node --disable-warning=ExperimentalWarning src/cli/import-knowledge.ts",
    "bench": "node --disable-warning=ExperimentalWarning src/cli/bench.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.2",
    "pg": "^8.23.1",
    "playwright-core": "^1.49.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
