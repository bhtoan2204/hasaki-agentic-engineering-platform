{
  "name": "claude-task-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workflow-driven AI engineering platform: work items, versioned workflows, durable step execution, Claude Code agents, Bitbucket PRs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "npm run build && node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --watch --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=4 test/*.test.ts",
    "eval:investigation": "node --disable-warning=ExperimentalWarning src/cli/evalInvestigation.ts",
    "eval:cleanup": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/evalCleanup.ts",
    "smoke:codex": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=4 test/codex.live.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "build": "vite build --config web/vite.config.ts",
    "serve": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "knowledge:import": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/import-knowledge.ts",
    "knowledge:rescope": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/rescope-knowledge.ts",
    "skills:import-external": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/import-external-skills.ts",
    "step:reexecute": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/reexecute-step.ts",
    "bench": "node --disable-warning=ExperimentalWarning src/cli/bench.ts",
    "admin:bootstrap": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/bootstrap-admin.ts",
    "bench:cache": "node --disable-warning=ExperimentalWarning --expose-gc src/cli/benchCache.ts",
    "bench:code-intelligence": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/code-intelligence.bench.ts",
    "validate:code-intelligence": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/validate-code-intelligence.ts",
    "repositories:migrate": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/migrate-repositories.ts",
    "smoke:analytics": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/analytics.smoke.ts",
    "smoke:provider-evaluation": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/provider-evaluation.smoke.ts",
    "smoke:handoff": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/provider-handoff.smoke.ts",
    "smoke:orchestration": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/step-agent.smoke.ts",
    "bench:live-updates": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/live-updates.bench.ts",
    "smoke:live-updates": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=4 test/live-updates.browser.ts",
    "smoke:run-view": "node --disable-warning=ExperimentalWarning test/run-view.smoke.ts",
    "smoke:ui-quality": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/ui-quality.browser.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knowledge:audit": "node --disable-warning=ExperimentalWarning src/cli/knowledge-audit.ts"
  },
  "dependencies": {
    "@alibaba-group/open-code-review": "1.13.6",
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.2",
    "mysql2": "3.24.2",
    "pg": "^8.23.1",
    "playwright-core": "^1.49.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tree-sitter-wasm": "2.0.4",
    "web-tree-sitter": "0.27.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5"
  }
}
