{
  "name": "claude-task-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workflow-driven AI engineering platform: work items, versioned workflows, durable step execution, Claude Code agents, Bitbucket PRs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "pg": "^8.23.1",
    "playwright-core": "^1.49.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
