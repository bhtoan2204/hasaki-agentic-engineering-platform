{
  "name": "hasaki-orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workflow-driven AI engineering platform: work items, versioned workflows, durable step execution, Claude Code agents, Bitbucket PRs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "sh scripts/ensure-bwrap.sh",
    "start": "npm run build && node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "predev": "sh scripts/ensure-bwrap.sh",
    "dev": "node --watch --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/env.ts --test test/*.test.ts",
    "test:coverage": "node --disable-warning=ExperimentalWarning test/run-integration.ts --test-concurrency=4 --experimental-test-coverage --test-coverage-include=src/auth/** --test-coverage-include=src/authz/** --test-coverage-include=src/workflow/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=.coverage/lcov.info test/*.test.ts test/*.integration.ts",
    "coverage:check": "node --disable-warning=ExperimentalWarning scripts/coverage-check.ts",
    "test:integration": "node --disable-warning=ExperimentalWarning test/run-integration.ts --test-concurrency=8 test/*.integration.ts",
    "test:all": "npm test && npm run test:integration",
    "eval:investigation": "node --disable-warning=ExperimentalWarning src/cli/evalInvestigation.ts",
    "eval:retrieval": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/evalRetrieval.ts",
    "eval:autonomy": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/evalAutonomy.ts",
    "eval:autonomy:ci": "node --disable-warning=ExperimentalWarning --import ./test/env.ts src/cli/evalAutonomy.ts --no-db",
    "bench:tokens": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/benchTokens.ts",
    "eval:import": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/evalImport.ts",
    "eval:cleanup": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/evalCleanup.ts",
    "smoke:codex": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=4 test/codex.live.ts",
    "smoke:copilot": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=4 test/copilot.live.ts",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile node_modules/.cache/tsc/root.tsbuildinfo && tsc -p web --incremental --tsBuildInfoFile node_modules/.cache/tsc/web.tsbuildinfo",
    "build": "vite build --config web/vite.config.ts && node --disable-warning=ExperimentalWarning scripts/precompress-web.ts",
    "serve": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "knowledge:import": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/import-knowledge.ts",
    "knowledge:rescope": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/rescope-knowledge.ts",
    "skills:import-external": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/import-external-skills.ts",
    "step:reexecute": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/reexecute-step.ts",
    "bench": "node --disable-warning=ExperimentalWarning src/cli/bench.ts",
    "auth:rotate-keys": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/rotate-keys.ts",
    "admin:bootstrap": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/bootstrap-admin.ts",
    "bench:dependencies": "node --disable-warning=ExperimentalWarning src/cli/bench-dependencies.ts",
    "bench:cache": "node --disable-warning=ExperimentalWarning --expose-gc src/cli/benchCache.ts",
    "bench:api": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/benchApi.ts",
    "bench:lsp": "node --disable-warning=ExperimentalWarning src/cli/benchLsp.ts",
    "bench:codeact": "node --disable-warning=ExperimentalWarning src/cli/benchCodeAct.ts",
    "eval:codeact": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts src/cli/evalCodeAct.ts",
    "bench:code-intelligence": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/code-intelligence.bench.ts",
    "build:go": "cd go && CGO_ENABLED=1 go build -trimpath -o bin/ ./cmd/platform-go ./cmd/platform-supervise",
    "bench:runtime": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/runtime.bench.ts",
    "bench:process": "node --disable-warning=ExperimentalWarning --import ./test/env.ts test/process-supervision.bench.ts",
    "validate:code-intelligence": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/validate-code-intelligence.ts",
    "db:diagnostics": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/storage-diagnostics.ts",
    "db:storage": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/storage-diagnostics.ts",
    "repositories:migrate": "node --use-system-ca --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli/migrate-repositories.ts",
    "smoke:analytics": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/analytics.smoke.ts",
    "smoke:provider-evaluation": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/provider-evaluation.smoke.ts",
    "smoke:handoff": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/provider-handoff.smoke.ts",
    "smoke:orchestration": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/step-agent.smoke.ts",
    "bench:live-updates": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/live-updates.bench.ts",
    "smoke:live-updates": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=4 test/live-updates.browser.ts",
    "smoke:work-item": "node --disable-warning=ExperimentalWarning test/work-item-settings.smoke.ts",
    "smoke:trace": "node --disable-warning=ExperimentalWarning test/trace-explorer.smoke.ts",
    "smoke:run-view": "node --disable-warning=ExperimentalWarning test/run-view.smoke.ts",
    "smoke:observability": "node --disable-warning=ExperimentalWarning test/execution-observability.smoke.ts",
    "smoke:prod-errors-tabs": "node --disable-warning=ExperimentalWarning test/prod-errors-tabs.smoke.ts",
    "smoke:incident-workbench": "node --disable-warning=ExperimentalWarning test/incident-workbench.smoke.ts",
    "smoke:run-delegation": "node --disable-warning=ExperimentalWarning test/run-delegation.smoke.ts",
    "smoke:overview-timesheet": "node --disable-warning=ExperimentalWarning test/overview-timesheet.smoke.ts",
    "smoke:chat": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=4 test/chat.browser.ts",
    "smoke:run-detail": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-concurrency=4 test/run-detail.browser.ts",
    "smoke:bug-hunter": "node --disable-warning=ExperimentalWarning test/run-integration.ts --test-concurrency=4 test/bug-hunter.browser.ts",
    "smoke:ui-quality": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts test/ui-quality.browser.ts",
    "arch:check": "node --disable-warning=ExperimentalWarning scripts/arch-check.ts",
    "arch:baseline": "node --disable-warning=ExperimentalWarning scripts/arch-check.ts --write-baseline",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knowledge:audit": "node --disable-warning=ExperimentalWarning src/cli/knowledge-audit.ts"
  },
  "dependencies": {
    "@alibaba-group/open-code-review": "1.14.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.2.1",
    "mysql2": "3.24.6",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tree-sitter-wasm": "2.0.4",
    "web-tree-sitter": "0.27.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
